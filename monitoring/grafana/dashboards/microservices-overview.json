{
  "title": "Microservices Overview",
  "tags": ["microservices", "overview"],
  "timezone": "browser",
  "schemaVersion": 27,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Data Ingestor - Requests per Second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"data-ingestor\"}[1m]))",
          "legendFormat": "All HTTP Requests",
          "refId": "A"
        },
        {
          "expr": "sum(rate(dataingestor_api_requests_count_total[1m]))",
          "legendFormat": "API Requests",
          "refId": "B"
        },
        {
          "expr": "sum(rate(dataingestor_data_fetched_count_total[1m]))",
          "legendFormat": "Data Fetched",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "title": "Data Processor - Messages Processed",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "rate(dataprocessor_messages_processed_total[1m])",
          "legendFormat": "Processed",
          "refId": "A"
        },
        {
          "expr": "rate(dataprocessor_messages_failed_total[1m])",
          "legendFormat": "Failed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "msgps"
        }
      }
    },
    {
      "id": 3,
      "title": "GraphQL Gateway - Query Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(http_server_request_duration_seconds_count{job=\"graphql-gateway\"}[1m])",
          "legendFormat": "Queries/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 4,
      "title": "Notification Service - Notifications Sent",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "rate(notificationservice_notifications_sent_total[1m])",
          "legendFormat": "Sent",
          "refId": "A"
        },
        {
          "expr": "rate(notificationservice_notifications_failed_total[1m])",
          "legendFormat": "Failed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "notifps"
        }
      }
    },
    {
      "id": 5,
      "title": "API Request Duration (Data Ingestor)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(dataingestor_api_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(dataingestor_api_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "title": "Processing Duration (Data Processor)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(dataprocessor_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 7,
      "title": "Service Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "up{job=~\"data-ingestor|data-processor|graphql-gateway|notification-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        }
      }
    }
  ]
}
