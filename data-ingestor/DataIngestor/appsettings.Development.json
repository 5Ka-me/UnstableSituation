{
  "Server": {
    "Port": "8080",
    "Host": "localhost"
  },
  "Api": {
    "BaseUrl": "http://localhost:8081",
    "Timeout": "00:00:30",
    "RetryCount": 3,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDuration": "00:01:00"
  },
  "RabbitMQ": {
    "Url": "amqp://guest:guest@localhost:5672/",
    "ExchangeName": "meter-data-exchange",
    "QueueName": "meter-data-queue",
    "RoutingKey": "meter.data",
    "RetryCount": 3,
    "RetryDelay": "00:00:05"
  },
  "Logging": {
    "Level": "Information",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
